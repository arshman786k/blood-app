# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ====================================
# FIREBASE CONFIGURATION
# ====================================
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# ====================================
# CLOUDINARY CONFIGURATION
# ====================================
# Get these from: Cloudinary Dashboard > Settings > Upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ====================================
# FLASK API CONFIGURATION
# ====================================
# Your Flask backend URL
FLASK_API_URL=http://192.168.1.12:5000

# ====================================
# NOTES:
# ====================================
# 1. Never commit .env file to version control
# 2. Update config/firebase.ts with your Firebase credentials
# 3. Update services/cloudinaryService.ts with your Cloudinary credentials
# 4. Update app/(tabs)/index.tsx with your Flask API URL
